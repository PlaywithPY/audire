// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Settings généraux du site
model SiteSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Centres Audire (multi-centres)
model Centre {
  id           Int      @id @default(autoincrement())
  name         String   // Nom du centre (ex: "Audire Jemeppe")
  slug         String   @unique // Identifiant unique (ex: "jemeppe", "liege")
  phoneFixe    String   // Téléphone fixe
  phoneMobile  String?  // Téléphone mobile (GSM)
  email        String   // Email du centre
  address      String   // Adresse complète
  postalCode   String   // Code postal
  city         String   // Ville
  isActive     Boolean  @default(true) // Centre actif ou non
  isDefault    Boolean  @default(false) // Centre par défaut
  latitude     Float?   // Latitude pour la recherche géographique (future fonctionnalité)
  longitude    Float?   // Longitude pour la recherche géographique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  openingHours OpeningHours[]

  @@index([postalCode])
  @@index([isActive])
}

// Horaires d'ouverture par jour (liés à un centre)
model OpeningHours {
  id            Int     @id @default(autoincrement())
  centreId      Int     // Lien vers le centre
  centre        Centre  @relation(fields: [centreId], references: [id], onDelete: Cascade)
  dayOfWeek     Int     // 0 = dimanche, 1 = lundi, ..., 6 = samedi
  isOpen        Boolean @default(true)
  morningOpen   String? // Format "HH:MM"
  morningClose  String? // Format "HH:MM"
  afternoonOpen String? // Format "HH:MM"
  afternoonClose String? // Format "HH:MM"
  updatedAt     DateTime @updatedAt

  @@unique([centreId, dayOfWeek])
  @@index([centreId])
}

// Thème/Couleurs du site
model ThemeColors {
  id           Int      @id @default(autoincrement())
  primary      String   @default("#42a4ff")
  primaryLight String   @default("#5ab3ff")
  primaryDark  String   @default("#2d87e6")
  secondary    String   @default("#EBF5FF")
  updatedAt    DateTime @updatedAt
}

// Images pour les cards (remplace les émojis)
model CardImage {
  id            Int      @id @default(autoincrement())
  pageKey       String   @default("home") // Page où se trouve la card (ex: "home", "notre-accompagnement")
  cardKey       String   // Identifiant unique de la card (ex: "solutions-oticon")
  imageUrl      String   // URL de l'image
  fallbackEmoji String   @default("📷") // Emoji de fallback
  imagePosition String   @default("center center") // Position de l'image (object-position CSS)
  href          String?  // Lien vers une page
  title         String?  // Titre de la card
  description   String?  // Description de la card
  imageAlt      String?  // Texte alternatif pour l'image
  updatedAt     DateTime @updatedAt

  @@unique([pageKey, cardKey])
  @@index([pageKey])
}

// Sections avec images de fond
model SectionBackground {
  id          Int      @id @default(autoincrement())
  sectionKey  String   @unique // Identifiant de la section (ex: "hero-home")
  imageUrl    String?  // URL de l'image de fond (null = utiliser le gradient par défaut)
  updatedAt   DateTime @updatedAt
}

// Blocs de contenu éditables (WYSIWYG)
model ContentBlock {
  id          Int      @id @default(autoincrement())
  pageKey     String   // Page où se trouve le bloc (ex: "home", "contact")
  blockKey    String   // Identifiant unique du bloc (ex: "hero-title", "about-text")
  blockType   String   // Type de bloc: "title", "text", "image", "button", "html"
  content     String   // Contenu du bloc (texte, URL, HTML, etc.)
  metadata    String?  // Métadonnées JSON (style, position, etc.)
  order       Int      @default(0) // Ordre d'affichage
  isVisible   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([pageKey, blockKey])
  @@index([pageKey, order])
}

// Avis clients
model Testimonial {
  id          Int      @id @default(autoincrement())
  name        String   // Nom du client (ou initiales)
  text        String   // Texte de l'avis
  rating      Int      @default(5) // Note sur 5
  location    String?  // Ville (ex: "Liège")
  isVisible   Boolean  @default(true)
  isFeatured  Boolean  @default(false) // Mettre en avant sur la page d'accueil
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isVisible, isFeatured])
}

// Catégories de perte auditive
model HearingLossCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique // Ex: "Légère", "Moyenne", "Sévère", "Profonde"
  slug        String    @unique // Ex: "legere", "moyenne", "severe", "profonde"
  minDb       Int?      // Seuil minimal en dB (ex: 26)
  maxDb       Int?      // Seuil maximal en dB (ex: 40)
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([order])
}

// Types d'appareils auditifs
model DeviceType {
  id          Int       @id @default(autoincrement())
  name        String    @unique // Ex: "Contour d'oreille", "Intra-auriculaire", "RIC"
  slug        String    @unique // Ex: "contour", "intra", "ric"
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([order])
}

// Produits (appareils auditifs)
model Product {
  id                    Int                  @id @default(autoincrement())
  name                  String               // Nom du produit (ex: "Phonak Virto R Infinio")
  slug                  String               @unique // URL-friendly (ex: "phonak-virto-r-infinio")
  brand                 String               // Marque (ex: "Phonak", "Oticon", "Bernafon")
  model                 String?              // Modèle spécifique
  shortDescription      String               // Description courte pour les listes
  fullDescription       String?              // Description complète pour la page détail
  price                 Float?               // Prix unitaire (optionnel)
  priceRange            String?              // Fourchette de prix (ex: "1500€ - 2500€")
  imageUrl              String?              // Image principale du produit
  imagePosition         String               @default("center center") // Position de l'image
  imageAlt              String?              // Texte alternatif pour l'image
  isVisible             Boolean              @default(true)
  isFeatured            Boolean              @default(false) // Produit mis en avant
  order                 Int                  @default(0) // Ordre d'affichage

  // Contrôles de visibilité des informations
  showBrand             Boolean              @default(true) // Afficher la marque
  showPrice             Boolean              @default(true) // Afficher le prix/fourchette
  showShortDescription  Boolean              @default(true) // Afficher la description courte
  showFullDescription   Boolean              @default(true) // Afficher la description complète
  showImage             Boolean              @default(true) // Afficher l'image
  showFeatures          Boolean              @default(true) // Afficher les caractéristiques
  showProsCons          Boolean              @default(true) // Afficher avantages/inconvénients
  showDeviceType        Boolean              @default(true) // Afficher le type d'appareil
  showHearingLossLevel  Boolean              @default(true) // Afficher le niveau de perte auditive

  // Relations
  hearingLossCategoryId Int?
  hearingLossCategory   HearingLossCategory? @relation(fields: [hearingLossCategoryId], references: [id])
  deviceTypeId          Int?
  deviceType            DeviceType?          @relation(fields: [deviceTypeId], references: [id])

  // Caractéristiques techniques (JSON flexible)
  features              String?              // JSON: {"bluetooth": true, "rechargeable": true, "waterproof": "IP68", etc.}

  // Avantages et inconvénients
  pros                  String?              // JSON array: ["Avantage 1", "Avantage 2"]
  cons                  String?              // JSON array: ["Inconvénient 1", "Inconvénient 2"]

  // SEO
  metaTitle             String?
  metaDescription       String?             
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([isVisible, isFeatured])
  @@index([brand])
  @@index([slug])
  @@index([order])
}
