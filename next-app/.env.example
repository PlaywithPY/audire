# PostgreSQL connection string
# Pour Vercel Postgres, Neon, Supabase ou Prisma Data Platform
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

DATABASE_URL="postgresql://postgres:password@localhost:5432/audire?schema=public"

# Alternative: Prisma Data Platform (Accelerate)
# DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"

# NextAuth Configuration
# URL de votre application (en production: https://votre-domaine.com)
NEXTAUTH_URL="http://localhost:3000"
# Secret pour signer les tokens JWT (générez une longue chaîne aléatoire)
# Vous pouvez utiliser: openssl rand -base64 32
NEXTAUTH_SECRET="changez-ce-secret-en-production-avec-une-longue-chaine-aleatoire"

# Admin Credentials
# IMPORTANT: Changez ces valeurs en production !
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changez-ce-mot-de-passe"
