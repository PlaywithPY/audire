# PostgreSQL connection string
# Pour Vercel Postgres, Neon, Supabase ou Prisma Data Platform
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

DATABASE_URL="postgresql://postgres:password@localhost:5432/audire?schema=public"

# Direct connection URL (required for Prisma migrations)
# For Neon: use the non-pooled connection URL (without -pooler)
# For local PostgreSQL: same as DATABASE_URL
DIRECT_URL="postgresql://postgres:password@localhost:5432/audire?schema=public"

# Alternative: Prisma Data Platform (Accelerate)
# DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"

# NextAuth Configuration
# URL de votre application (en production: https://votre-domaine.com)
NEXTAUTH_URL="http://localhost:3000"
# Secret pour signer les tokens JWT (générez une longue chaîne aléatoire)
# Vous pouvez utiliser: openssl rand -base64 32
NEXTAUTH_SECRET="changez-ce-secret-en-production-avec-une-longue-chaine-aleatoire"

# Admin Credentials
# IMPORTANT: Changez ces valeurs en production !
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changez-ce-mot-de-passe"

# Vercel Blob Storage (pour l'upload d'images)
# Sur Vercel, ce token est automatiquement créé quand vous activez Blob Storage
# En local, laissez vide pour utiliser le filesystem (public/uploads)
# Pour obtenir ce token: Vercel Dashboard → Storage → Create Database → Blob
BLOB_READ_WRITE_TOKEN=""

# Google Calendar API (pour les rendez-vous)
# Pour obtenir ces credentials: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="RDV Site" # Nom de l'agenda Google Calendar

# Email Configuration (pour l'envoi des prescriptions)
# Pour Gmail: utilisez un mot de passe d'application (App Password)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="centre.audire@gmail.com"
EMAIL_PASSWORD="" # Mot de passe d'application Gmail
EMAIL_FROM="centre.audire@gmail.com"
EMAIL_TO="centre.audire@gmail.com"

# Cron Job Secret (pour sécuriser les tâches planifiées)
# Générez une chaîne aléatoire : openssl rand -base64 32
CRON_SECRET="changez-ce-secret-en-production"
